{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wrangell-dog",
	"main": "src/index.js",
	"compatibility_date": "2026-05-13",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Static assets normally short-circuit the Worker. Run the Worker first for the
		// homepage only, so it can serve the wedding page at "/" during wedding week;
		// every other path keeps the fast direct-to-asset path.
		"run_worker_first": [
			"/",
			"/index.html"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "PETS",
			"id": "4bb7f3d585ac4b37a5c2b6e4d3b5a1b0"
		}
	]
}
