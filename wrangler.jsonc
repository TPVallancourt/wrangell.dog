{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wrangell-dog",
	"main": "src/index.js",
	"compatibility_date": "2026-05-13",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Static assets normally win before the Worker runs. Only captions.js is listed here,
		// so the Worker can generate it from KV. Never add "/images/*": static asset requests
		// are free and unlimited, while Worker invocations are capped on the free plan.
		"run_worker_first": [
			"/captions.js"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "wrangell-photos"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PETS",
			"id": "4bb7f3d585ac4b37a5c2b6e4d3b5a1b0"
		}
	]
}
